# 墨池环境变量示例
# 使用方法：复制本文件为 .env 并填入真实值。
# 注意：.env 已被 .gitignore 忽略，禁止提交真实密钥。

# Flask 会话签名密钥（必须替换为随机长字符串，如 uuid 或 openssl rand -hex 32）
SECRET_KEY=change-me-to-a-long-random-string

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=inkstone
MYSQL_PORT=3306

# ---- AI（OpenAI 兼容主供商 + 兜底，2026-09）----
# OpenAI 兼容主供商：三选一示例（注册与 Key 获取见对话说明）
#   阿里云百炼(通义):   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-turbo
#   火山方舟(豆包):     AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3          AI_MODEL=<推理接入点ID>
#   智谱GLM:            AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4             AI_MODEL=glm-4.7-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 兜底供应商（主供商失败自动回退，建议接智谱 GLM-Flash 免费档）
AI_FALLBACK_ENABLED=0
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
